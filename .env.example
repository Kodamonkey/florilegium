# Florilegio — configuración del servidor opcional con IA (server/).
# Copia este archivo como .env (queda fuera de git) y completa lo que necesites.
# Las variables ya definidas en el entorno tienen prioridad sobre este archivo.

# Clave de la API de Claude (https://platform.claude.com). Sin ella, la IA queda apagada
# y la página usa su lectura local. También sirve ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=

# Modelo de Claude que lee y propone ramos.
FLORILEGIO_MODEL=claude-opus-5

# Esfuerzo del modelo: low, medium, high, xhigh o max. Más esfuerzo piensa más, tarda más y cuesta más.
FLORILEGIO_EFFORT=medium

# Si el modelo declina un pedido, la API lo reintenta en el modelo de respaldo que Anthropic recomienda
# (fallbacks "default"). 0 lo apaga, por ejemplo si usas un modelo que no admite respaldos.
FLORILEGIO_FALLBACKS=

# Interruptor de la IA. Vacío: se enciende sola si hay ANTHROPIC_API_KEY o ANTHROPIC_AUTH_TOKEN.
# 1: la fuerza (por ejemplo, si iniciaste sesión con `ant auth login` y no usas variables).
# 0: la apaga aunque haya clave.
FLORILEGIO_AI=

# Nombres de host extra desde los que se puede usar el servidor (separados por coma).
# Por defecto solo este computador: localhost, 127.0.0.1 y [::1]. Protege contra el «DNS rebinding».
FLORILEGIO_HOSTS=

# Máximo de pedidos a la IA por cliente cada 10 minutos (30 por defecto).
FLORILEGIO_RATE=
